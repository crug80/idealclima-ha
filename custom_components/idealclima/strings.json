    },
    "step": {
      "serial": {
        "data": {
          "baudrate": "[%key:component::modbus::common::baud_rate%]",
          "device": "[%key:component::modbus::common::serial_port%]",
          "model": "Model",
          "unit_id": "[%key:component::idealclima::config::step::tcp::data::unit_id%]"
        },
        "data_description": {
          "baudrate": "The speed of the RS485 bus, as configured on the fan coil. The Ideal Clima default is 9600.",
          "device": "[%key:component::modbus::common::serial_port_description%]",
          "model": "[%key:component::idealclima::config::step::tcp::data_description::model%]",
          "unit_id": "[%key:component::idealclima::config::step::tcp::data_description::unit_id%]"
        },
        "description": "Set up an Ideal Clima fan coil wired to a serial port over RS485."
      },
      "tcp": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "model": "Model",
          "port": "[%key:common::config_flow::data::port%]",
          "unit_id": "Modbus unit ID"
        },
        "data_description": {
          "host": "[%key:component::modbus::common::tcp_host_description%]",
          "model": "The Ideal Clima fan coil model connected to this Modbus address.",
          "port": "[%key:component::modbus::common::tcp_port_description%]",
          "unit_id": "The fan coil's Modbus unit ID (1–32, excluding the factory address 15)."
        },
        "description": "Set up an Ideal Clima fan coil reached over the network through a Modbus TCP gateway."
      },
      "user": {
        "description": "Choose how your Ideal Clima fan coil is connected to Home Assistant.",
        "menu_options": {
          "serial": "[%key:component::modbus::common::serial_rtu%]",
          "tcp": "[%key:component::modbus::common::modbus_tcp%]"
        }
      },
      "reconfigure": {
        "description": "[%key:component::idealclima::config::step::user::description%]",
        "menu_options": {
          "serial": "[%key:component::modbus::common::serial_rtu%]",
          "tcp": "[%key:component::modbus::common::modbus_tcp%]"
        }
      }
    }
